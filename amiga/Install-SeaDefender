; $VER: Install-SeaDefender 1.0-gfos1 (17.11.2026)
; The Amiga Installer script for SeaDefender, an AmiCradle game port.
; Made by amicradle scripts/ports/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the SeaDefender drawer where the archive was unpacked.

(set @app-name "SeaDefender")
(set #version "1.0-gfos1")
(set #drawer "SeaDefender")
(set #program "SeaDefender")
(set #space 977)  ; KB

(onerror
    (message (cat "SeaDefender was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-SeaDefender again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "SeaDefender needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "SeaDefender needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "SeaDefender needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The SeaDefender drawer is not beside Install-SeaDefender. Unpack the whole archive, then run Install-SeaDefender from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The SeaDefender drawer has no SeaDefender in it. Unpack the whole archive again."))

(welcome "This installs SeaDefender 1.0-gfos1 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the SeaDefender drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called SeaDefender in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": SeaDefender needs 1 MB free.")))

; GFOpenGPU's modules: in LIBS:GFOpenGPU/, or copied there from LIBS:OpenGPU/
; (older instances have only that); none is copied before all are found
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2.module" (noreq)) 1))
    (abort "SeaDefender needs GFOpenGPU's SDL2.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-SeaDefender again. Nothing has been installed."))
(if (and (<> (exists "LIBS:GFOpenGPU/GL.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/GL.module" (noreq)) 1))
    (abort "SeaDefender needs GFOpenGPU's GL.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-SeaDefender again. Nothing has been installed."))
(if (<> (exists "LIBS:GFOpenGPU" (noreq)) 2)
    (makedir "LIBS:GFOpenGPU"))
(if (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying SDL2.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "SDL2.module")))
(if (<> (exists "LIBS:GFOpenGPU/GL.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying GL.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "GL.module")))
(complete 20)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "sea.hsc") (noreq))
    (set #kept (if (= #kept "") "sea.hsc" (cat #kept "|" "sea.hsc"))))
(if (exists (tackon #dest "sea.cfg") (noreq))
    (set #kept (if (= #kept "") "sea.cfg" (cat #kept "|" "sea.cfg"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying SeaDefender")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating SeaDefender. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "SeaDefender.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "SeaDefender.info")))

(set #later "")
(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. SeaDefender would have gone in " #dest "."))
    (message (cat "SeaDefender 1.0-gfos1 is installed in " #dest "."
                  "\n\nTo start it, open the SeaDefender drawer and double-click the SeaDefender icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept "."))
                  (if (= #later "") "" (cat "\n\nStill to add to the drawer: " #later ". Run Install-SeaDefender again to fetch or copy it.")))))
(exit (quiet))
