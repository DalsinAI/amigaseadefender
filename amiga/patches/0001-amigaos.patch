diff --git a/snoutlib/mfont.cpp b/snoutlib/mfont.cpp
index 875c34e..847fa23 100644
--- a/snoutlib/mfont.cpp
+++ b/snoutlib/mfont.cpp
@@ -317,9 +317,10 @@ void MFont::read_from_data(void) {
 
 float MFont::get_num(void)
 {
-  const unsigned short *num = reinterpret_cast<const unsigned short*>(&m_data[m_data_ptr]);
+  // little-endian 16-bit, byte by byte: the same on every machine
+  unsigned short num = m_data[m_data_ptr] | (m_data[m_data_ptr + 1] << 8);
   m_data_ptr += 2; // 16-bit
-  return ((float)*num / m_divisor);
+  return ((float)num / m_divisor);
 }
 
 vec2 MFont::get_vec2(void)
